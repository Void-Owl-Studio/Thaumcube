/builds/
/exports/
/*.pck
/*.apk
/*.aab
/*.ipa
/*.exe
/*.x86_64
/*.x86_32
/*.zip
/*.dmg
/*.app

# Export credentials and signing keys
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision

# Mono/.NET build artifacts
.mono/
bin/
obj/
*.csproj.user
*.suo

# IDE/editor files
.idea/
.vscode/
*.code-workspace
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.orig
*.pid
logs/
